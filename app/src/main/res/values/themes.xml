<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.VetFinance" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <item name="colorPrimary">@color/vetfinance_primary</item>
        <item name="colorPrimaryVariant">@color/vetfinance_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>

        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>

    </style>

    <style name="Theme.VetFinance.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/vetfinance_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/vetfinance_splash_icon_bg</item>
        <item name="postSplashScreenTheme">@style/Theme.VetFinance</item>
    </style>
</resources>
